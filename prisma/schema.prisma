// LeadOS Prisma schema
// Multi-tenant SaaS: every client-owned model includes tenantId.
// TODO: add Supabase RLS policies in a follow-up migration once auth is wired
// end-to-end. Until then, tenant isolation is enforced at the application layer
// via src/lib/access.ts.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum Role {
  super_admin
  agency_owner
  agency_admin
  tenant_admin
  agent
  viewer
}

enum MembershipScope {
  agency
  tenant
}

enum TenantStatus {
  active
  paused
  archived
}

enum OpportunityStatus {
  open
  won
  lost
}

enum WorkflowTriggerType {
  form_submitted
  opportunity_stage_changed
  appointment_booked
}

enum WorkflowRunStatus {
  success
  skipped
  failed
  pending
}

enum BlueprintItemType {
  pipeline
  form
  workflow
  tag
  setting
}

enum BlueprintOwnerType {
  system
  agency
}

enum AppointmentStatus {
  scheduled
  completed
  cancelled
  no_show
}

enum ConversationChannel {
  sms
  email
  note
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageStatus {
  queued
  sent
  delivered
  failed
  received
}

// =============================================================================
// USERS, AGENCIES, TENANTS, MEMBERSHIPS
// =============================================================================

model UserProfile {
  id          String   @id @default(cuid())
  authUserId  String   @unique
  email       String   @unique
  name        String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships  Membership[]
  auditEvents  AuditEvent[]

  @@index([email])
}

model Agency {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  brandingJson  Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenants            Tenant[]
  memberships        Membership[]
  blueprints         Blueprint[]
  billingSubscription BillingSubscription?

  @@index([slug])
}

model Tenant {
  id                String       @id @default(cuid())
  agencyId          String
  name              String
  slug              String
  status            TenantStatus @default(active)
  brandingJson      Json?
  businessInfoJson  Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  agency             Agency               @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  memberships        Membership[]
  contacts           Contact[]
  pipelines          Pipeline[]
  opportunities      Opportunity[]
  forms              Form[]
  formSubmissions    FormSubmission[]
  conversations      Conversation[]
  messages           Message[]
  appointments       Appointment[]
  workflowDefinitions WorkflowDefinition[]
  workflowRuns       WorkflowRun[]
  providerAccounts   ProviderAccount[]
  auditEvents        AuditEvent[]
  blueprintInstalls  BlueprintInstall[]

  @@unique([agencyId, slug])
  @@index([agencyId])
  @@index([slug])
}

model Membership {
  id            String          @id @default(cuid())
  userProfileId String
  scope         MembershipScope
  agencyId      String?
  tenantId      String?
  role          Role
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  userProfile UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  agency      Agency?     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  tenant      Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userProfileId, agencyId, tenantId])
  @@index([userProfileId])
  @@index([agencyId])
  @@index([tenantId])
}

// =============================================================================
// CRM: CONTACTS, PIPELINES, OPPORTUNITIES
// =============================================================================

model Contact {
  id            String   @id @default(cuid())
  tenantId      String
  firstName     String?
  lastName      String?
  email         String?
  phone         String?
  source        String?
  tags          String[] @default([])
  notes         String?
  consentSms    Boolean  @default(false)
  consentEmail  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunities   Opportunity[]
  formSubmissions FormSubmission[]
  conversations   Conversation[]
  appointments    Appointment[]

  @@index([tenantId])
  @@index([tenantId, email])
  @@index([tenantId, phone])
}

model Pipeline {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages        PipelineStage[]
  opportunities Opportunity[]

  @@index([tenantId])
}

model PipelineStage {
  id          String   @id @default(cuid())
  tenantId    String
  pipelineId  String
  name        String
  position    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@unique([pipelineId, position])
  @@index([tenantId])
  @@index([pipelineId])
}

model Opportunity {
  id          String            @id @default(cuid())
  tenantId    String
  contactId   String?
  pipelineId  String
  stageId     String
  title       String
  value       Decimal?          @db.Decimal(12, 2)
  status      OpportunityStatus @default(open)
  source      String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact  Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  pipeline Pipeline       @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage    PipelineStage  @relation(fields: [stageId], references: [id])

  @@index([tenantId])
  @@index([pipelineId, stageId])
  @@index([contactId])
}

// =============================================================================
// FORMS + SUBMISSIONS
// =============================================================================

model Form {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  schemaJson  Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submissions FormSubmission[]

  @@unique([slug])
  @@index([tenantId])
}

model FormSubmission {
  id          String   @id @default(cuid())
  tenantId    String
  formId      String
  contactId   String?
  payloadJson Json
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  form    Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([formId])
  @@index([contactId])
}

// =============================================================================
// CONVERSATIONS + MESSAGES (placeholders for Phase 2 messaging)
// =============================================================================

model Conversation {
  id             String              @id @default(cuid())
  tenantId       String
  contactId      String
  channel        ConversationChannel
  lastMessageAt  DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact  Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([tenantId, contactId, channel])
  @@index([tenantId])
  @@index([contactId])
  @@index([tenantId, lastMessageAt])
}

model Message {
  id                String           @id @default(cuid())
  tenantId          String
  conversationId    String
  direction         MessageDirection
  status            MessageStatus    @default(queued)
  body              String
  subject           String?
  fromAddress       String?
  toAddress         String?
  providerMessageId String?
  errorMessage      String?
  createdAt         DateTime         @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([conversationId])
  @@index([providerMessageId])
}

// =============================================================================
// APPOINTMENTS (placeholder)
// =============================================================================

model Appointment {
  id          String            @id @default(cuid())
  tenantId    String
  contactId   String?
  title       String
  startsAt    DateTime
  endsAt      DateTime?
  status      AppointmentStatus @default(scheduled)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([contactId])
}

// =============================================================================
// WORKFLOWS
// =============================================================================

model WorkflowDefinition {
  id          String              @id @default(cuid())
  tenantId    String
  name        String
  triggerType WorkflowTriggerType
  actionsJson Json
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   WorkflowRun[]

  @@index([tenantId])
  @@index([tenantId, triggerType, isActive])
}

model WorkflowRun {
  id            String            @id @default(cuid())
  tenantId      String
  workflowId    String
  triggerType   WorkflowTriggerType
  status        WorkflowRunStatus  @default(pending)
  contextJson   Json?
  resultJson    Json?
  errorMessage  String?
  createdAt     DateTime           @default(now())
  completedAt   DateTime?

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([workflowId])
}

// =============================================================================
// PROVIDER ACCOUNTS (Twilio/Resend/etc – placeholders)
// =============================================================================

model ProviderAccount {
  id          String   @id @default(cuid())
  tenantId    String
  provider    String   // "twilio" | "resend" | "stripe" | ...
  configJson  Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@index([tenantId])
}

// =============================================================================
// BILLING (placeholder)
// =============================================================================

model BillingSubscription {
  id                String   @id @default(cuid())
  agencyId          String   @unique
  stripeCustomerId  String?
  stripeSubscriptionId String?
  plan              String?  // starter | growth | agency
  status            String?  // active | past_due | canceled | trialing
  currentPeriodEnd  DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
}

// =============================================================================
// AUDIT
// =============================================================================

model AuditEvent {
  id            String   @id @default(cuid())
  tenantId      String?
  agencyId      String?
  userProfileId String?
  action        String
  targetType    String?
  targetId      String?
  metadataJson  Json?
  createdAt     DateTime @default(now())

  tenant      Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  userProfile UserProfile? @relation(fields: [userProfileId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([agencyId])
  @@index([userProfileId])
  @@index([action])
}

// =============================================================================
// BLUEPRINTS
// =============================================================================

model Blueprint {
  id          String             @id @default(cuid())
  ownerType   BlueprintOwnerType
  agencyId    String?
  niche       String?
  name        String
  description String?
  slug        String             @unique
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  agency    Agency?            @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  items     BlueprintItem[]
  installs  BlueprintInstall[]

  @@index([ownerType])
  @@index([agencyId])
}

model BlueprintItem {
  id          String            @id @default(cuid())
  blueprintId String
  itemType    BlueprintItemType
  payloadJson Json
  position    Int               @default(0)
  createdAt   DateTime          @default(now())

  blueprint Blueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@index([blueprintId])
}

model BlueprintInstall {
  id          String   @id @default(cuid())
  blueprintId String
  tenantId    String
  resultJson  Json?
  createdAt   DateTime @default(now())

  blueprint Blueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([blueprintId, tenantId])
  @@index([tenantId])
  @@index([blueprintId])
}
